# ConvertX Environment Variables

# JWT secret for authentication (auto-generated if not set)
JWT_SECRET=your-secret-key-here

# URL prefix for deployment (e.g., "/convertx" if deployed at domain.com/convertx)
WEBROOT=

# Full API base URL for OpenAPI spec (e.g., "https://convertx.example.com/api/v1")
# If not set, will auto-detect from request headers
API_BASE_URL=

# Enable user registration (true/false)
ACCOUNT_REGISTRATION=true

# Allow usage without login (true/false)
ALLOW_UNAUTHENTICATED=false

# Allow HTTP connections (not just HTTPS) - only for development
HTTP_ALLOWED=false

# Auto-delete files after N hours (default: 24)
AUTO_DELETE_EVERY_N_HOURS=24

# Maximum parallel conversion processes (default: 5)
MAX_CONVERT_PROCESS=5

# Database path (optional, defaults to ./data/mydb.sqlite)
# DATABASE_PATH=./data/mydb.sqlite

# Port to run the server on (default: 3110)
# PORT=3110